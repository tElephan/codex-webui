{
  "id": "./",
  "name": "Codex WebUI",
  "short_name": "Codex",
  "description": "Codex browser workspace",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f7f8fa",
